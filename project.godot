; Engine configuration file.
; Edit through Godot when possible.

config_version=5

[application]

config/name="Desktop Pet Prototype"
config/icon="res://assets/ui/desktop_pet_icon.png"
config/windows_native_icon="res://assets/ui/desktop_pet_icon.ico"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)
boot_splash/minimum_display_time=0

[display]

window/size/viewport_width=360
window/size/viewport_height=360
window/size/window_width_override=360
window/size/window_height_override=360
window/size/resizable=false
window/size/borderless=true
window/size/transparent=true
window/size/always_on_top=false
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/google_oauth_export/plugin.cfg")

[debug]

file_logging/enable_file_logging=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
gl_compatibility/driver.windows="opengl3_angle"
gl_compatibility/fallback_to_native=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
viewport/transparent_background=true
