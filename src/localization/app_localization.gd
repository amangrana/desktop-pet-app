static func normalize(language: String) -> String:
	if language == CHINESE or language.begins_with("zh"):
		return CHINESE
	return ENGLISH


static func default_language() -> String:
	return normalize(OS.get_locale())


static func text(language: String, key: String, values: Array = []) -> String:
	var normalized := normalize(language)
	var language_strings: Dictionary = STRINGS.get(normalized, STRINGS[ENGLISH])
	var value := str(language_strings.get(key, STRINGS[ENGLISH].get(key, key)))
	if values.is_empty():
		return value
	return value % values
